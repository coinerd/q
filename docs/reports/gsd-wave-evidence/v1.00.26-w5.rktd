(kind . "wave-evidence")
(schema-version . 2)
(campaign . "v1.00.26")
(wave . "W5")
(wave-title . "Four-worker workflow stress and guarded activation — decision: hold behind the WORKFLOW_TEST_JOBS guard, worker count stays at the product default of 2")
(status . "ready-for-merge")
(implementation-sha . "53e56e2c83ad4843dd3d1a85854fe8126ab623e3")
(dependency-sha . "79002351852a84ae5d2ca9b71f54aa612fd9bd80")
(branch . "campaign/v1.00.26-w5")
(dependency-state . "branched from the W4-delivered stacked state (W4 @ 79002351): the batch-scheduler hold decision, the shard-measurement artifact pair, and all prior wave checkpoints are present in the tree and green before any W5 edit landed")
(attempt-history . ((attempt-1 . "ended in a provider/network infrastructure stop (no logic failure recorded by the runtime); the wave was preserved (attempt not consumed) and resumed from the committed state on campaign/v1.00.26-w5 — the red-first failing pins (46ab5b11), the guarded WORKFLOW_TEST_JOBS seam with the hold decision comment and the stress-evidence artifact (08466eaf), and the timestamp/sums correction (98f31b5c) were kept; this attempt re-verified all prior work green, fixed one real defect the resume review found (the HOLD comment block sat inside the backslash-continued run command, where a '#' line terminates the continuation — reproduced via a tmp scratch run that showed the runner receiving a command with all flags after 'racket scripts/run-tests.rkt' dropped, then moved the comments above the run block and re-verified with bash -n plus a live extraction of the shard run block; landed as 53e56e2c), then bound this evidence trio")))
(non-artifact-content-digest . "0c7fdc2080cf7f9923dd13ddc501c5e8d53702283c3ff35b459bb1317b039667")
(non-artifact-digest-inputs . ".github/workflows/ci.yml tests/test-ci-runtime-contract.rkt tests/test-worker-security.rkt (paths relative to repo root; reproduce with: cd q && for f in .github/workflows/ci.yml tests/test-ci-runtime-contract.rkt tests/test-worker-security.rkt; do git show 53e56e2c83ad4843dd3d1a85854fe8126ab623e3:$f | sha256sum; done | awk '{print $1}' | sort | sha256sum; tests/test-worker-security.rkt IS a digest input this wave — the plan's 'extended only if a workflow-isolation pin is missing' clause resolved to 'missing': no workflow-level worker-isolation pin existed before W5, so the per-worker HOME/workdir separation and contamination canary pins were added there)")
(measurement . ((gate-text . "Roadmap v1.00.26 §7 W5: prove four workflow workers are safe (zero cross-worker contamination) under stress, reconcile the nightly precedent with PR timeout differences, and activate four workers only if the guard holds: workflow p50 <= 220 s with all required checks green and isolation evidence clean. A missed or unavailable measurement records hold with observed numbers; targets are never revised inside the wave.")
                (gate-evaluable . #f)
                (gate-verdict . hold)
                (gate-verdict-label . "HOLD per the wave's own evidence rule: the required cohort of >= 5 real-CI four-worker PR runs does not exist in this delivery environment (0 runs — no GitHub Actions runner is available here), so measured workflow p50 is undefined, the activation gate is not evaluable, and the worker count stays at the guarded default of 2; this is a missing-evidence hold, not a contamination finding")
                (stress-cohort . "0 real-CI four-worker PR runs (required: >= 5); per-run workflow p50 therefore undefined — recorded as undefined, never as an estimate; targets unrevised (p50 <= 220 s stands)")
                (isolation-observed . "zero cross-worker contamination observed anywhere: the contamination detector (artifact/upload names without a matrix.shard axis, cache keys without a shard axis and without restore-keys, overlapping temp roots) scans the live workflows job clean, positive controls on fixtures all flag as they must, and the per-worker HOME/workdir separation pins hold; what is NOT observed is contamination behavior under four-worker load on hosted runners — unmeasurable here and named as the missing evidence")
                (nightly-vs-pr-reconciliation . "recorded in full in artifacts/ci-topology/v1.00.26-w5/stress-evidence.json (env/profile table: trigger, concurrency-cancel, runner contention, timeout budget, observed precedent for nightly and PR lanes): nightly starts cold and uncontended with generous timeouts, PR runs contend with concurrent bursts and in-progress cancellation, so the nightly/PR timeout difference is an environment artifact, not a scheduler or worker-count property; W4's PR-window queue trial (+8.7%/+24.8% vs batch) is cited as the contention-confounded precedent, and the 220 s target stays reserved for evaluation against a clean >= 5-run cohort only")
                (guard . "activation is a one-variable flip once the cohort exists: the repo variable WORKFLOW_TEST_JOBS=4 widens the inner workers to four via the ci.yml seam ${{ vars.WORKFLOW_TEST_JOBS == '4' && '4' || '2' }}; unset, 2, or any other value keeps the product default of 2; no code change is required for activation or rollback")
                (artifact . "artifacts/ci-topology/v1.00.26-w5/stress-evidence.json (schema q.ci-topology.workflow-worker-stress/1) binds every number and claim above; checksummed by artifacts/ci-topology/v1.00.26-w5/SHA256SUMS")))
(decision . ((outcome . "hold")
             (worker-count-stays . "2 — the workflows shard matrix stays shard: [0, 1] with --jobs \"$WORKFLOW_TEST_JOBS\" where the guarded env seam resolves WORKFLOW_TEST_JOBS to 2 unless the repo variable is exactly '4'; no unconditional four-worker count exists anywhere in ci.yml (both contract suites pin this negatively)")
             (missing-evidence-honesty . "the hold names exactly what is missing: a >= 5-run real-CI four-worker PR cohort with per-run p50 and zero contamination on hosted runners; the artifact records 0 of >= 5 runs, gate-evaluable=false, and refusal to fake or extrapolate a p50; the honest number is 'undefined', and the record keeps it that way")
             (contamination-not-found . "the hold is explicitly NOT a contamination finding: the detector, positive/negative controls, and isolation pins all pass; nothing observed argues against four workers — the evidence to argue FOR them simply cannot be produced in this environment")
             (guard-first-shape . "the seam landed in ci.yml so that future activation requires only the repo-variable flip; the guard itself is under contract test: only vars.WORKFLOW_TEST_JOBS == '4' widens, the worker count flows through --jobs \"$WORKFLOW_TEST_JOBS\", and the outer two-shard required-check graph (workflows (0), workflows (1)) is untouched, so W5 changes the worker count dimension only")
             (run-block-comment-placement . "the HOLD decision comment sits above the run command block, not inside the backslash-continued command: a '#' line inside a continued shell command terminates the continuation and would drop every later flag from the runner's argv — found during this attempt's resume review, reproduced via a tmp scratch run, fixed at 53e56e2c, and covered by a focused extraction check (the run block bash -n parses and the reconstructed command receives all flags)")
             (rollback . "documented before use and one line: leave the repo variable WORKFLOW_TEST_JOBS unset (or set it to anything other than '4'); the guard resolves the worker count back to the product default of 2 on the next run — no revert commit needed; recorded in the ci.yml comment, the stress artifact decision.rollback, and pinned present by the contract suite")))
(delivery . ((tdd-tests-first . #t)
             (contract-tests . "tests/test-ci-runtime-contract.rkt (extended with Pin 11: guarded WORKFLOW_TEST_JOBS seam with the exact vars.WORKFLOW_TEST_JOBS == '4' expression, --jobs \"$WORKFLOW_TEST_JOBS\" flow-through, no unconditional --jobs 4, --shard-index/--shard-total 2 stability, W5 decision comment with HOLD + artifact pointer + rollback documentation, stress-evidence.json schema/binding checks incl. gate-evaluable=false and real-ci-four-worker-pr-runs=0, and the contamination canary with positive/negative controls — 42 success(es) 0 failure(s) 0 error(s)), tests/test-worker-security.rkt (extended with the W5 workflow-worker isolation sub-suite: live ci.yml free of contamination signals across output names/cache keys/temp roots, positive controls for shared cache key, shared artifact names, and overlapping TMPDIR — 40 + 2 success(es) 0 failure(s) 0 error(s))")
             (focused-suite-command . "racket tests/test-ci-runtime-contract.rkt && racket tests/test-worker-security.rkt && sha256sum -c artifacts/ci-topology/v1.00.26-w5/SHA256SUMS && test \"$(git branch --show-current)\" != \"main\" — all green at implementation-sha; plus the run-block extraction check (sed the shard run block, bash -n, and a guarded dry execution) proving the shipped comment placement keeps the command intact")
             (artifacts . ((stress-evidence . "artifacts/ci-topology/v1.00.26-w5/stress-evidence.json (gate state with 0-of-5 runs and gate-evaluable=false, isolation scan + missing-for-activation naming, nightly/PR env/profile reconciliation, hold decision with activation path and one-line rollback, targets-unrevised=true)")
                           (sha256sums . "artifacts/ci-topology/v1.00.26-w5/SHA256SUMS (binds stress-evidence.json byte-for-byte; verified OK in-suite and standalone)")))
             (pr-plan . "single PR from campaign/v1.00.26-w5 to main carrying the guarded seam with the hold decision comment, the extended contract pins, the stress artifact pair, and this evidence trio; the PR records the hold per the wave rule (activation lands in the same PR only with complete green evidence — none exists); squash-merge and post-merge gate confirmation are coordinator-owned"))))
(record-only . "this evidence file adds no code and touches no digest input")
