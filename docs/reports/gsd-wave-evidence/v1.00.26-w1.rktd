(attempt-history . ((attempt-1 . "ended in a provider/network infrastructure stop before completion (no logic failure recorded by the runtime); the wave was preserved (attempt not consumed) and resumed from the committed state on campaign/v1.00.26-w1 — the lint split, policy update, DAG checkpoint, and test extensions from the prior attempt were kept and extended, not redone")))
(non-artifact-content-digest . "3da8e5265f39df1127aa1bc17dd456b9b29d02f57fa34fc69d355aacc1a2c7e2")
(non-artifact-digest-inputs . ".github/workflows/ci.yml scripts/required-pr-checks.policy scripts/gsd-gates/gate-claims.rkt tests/test-milestone-gate.rkt tests/test-ci-runtime-contract.rkt tests/test-w9-ci-workflow-verification.rkt (paths relative to repo root; reproduce with: cd q && for f in .github/workflows/ci.yml scripts/required-pr-checks.policy scripts/gsd-gates/gate-claims.rkt tests/test-milestone-gate.rkt tests/test-ci-runtime-contract.rkt tests/test-w9-ci-workflow-verification.rkt; do git show efe6adb465563b25b635f146dfca66c9a3a83cc8:$f | sha256sum; done | awk '{print $1}' | sort | sha256sum)")
(measurement . ((gate-text . "Roadmap v1.00.26 §7 W1: split the heavyweight Racket lint out of the PR critical path — keep check-name lint lightweight (governance controller tests + workflow YAML validation, still required) and introduce lint-quality (Racket lint, lint alignment, metadata inventory, blocking metadata lint) as required, applied via the §7.1 safe sequence so there is never a fail-open or never-reporting window; record the same-SHA before/after DAG timing checkpoint.")
                (gate-evaluable . #t)
                (gate-verdict . pass)
                (gate-verdict-label . "split green at implementation-sha (all three suites exit 0); PR squash-merge, the post-merge main-reporting check of lint-quality, and the branch-protection requirement addition are the runtime coordinator's owned flow and are not claimed as done inside this record")
                (lint-split . ".github/workflows/ci.yml: job lint now runs only the lightweight steps (Protected governance controller tests + Workflow YAML validation) — no setup-racket, no scripts/lint-all.rkt, no check-version-expectations, no check-lint-alignment, no classify-metadata; new job lint-quality carries the full Racket lint suite (scripts/lint-all.rkt, check-version-expectations, check-lint-alignment, metadata-inventory as artifact, metadata-lint blocking) with no downstream needs, so the heavyweight lint leaves the PR critical path")
                (policy-split . "scripts/required-pr-checks.policy adds lint-quality next to lint; scripts/gsd-gates/gate-claims.rkt ci-required-jobs exposes the same set; tests/test-ci-runtime-contract.rkt pins the required set equality and tests/test-w9-ci-workflow-verification.rkt re-pins it — lint remains required at every point of the sequence (fail-closed invariant), and the policy-vs-pins drift alarm still fails with both sides named")
                (critical-path-proof . "tests/test-ci-runtime-contract.rkt (31/31 green) pins the same-SHA before/after pairing in artifacts/ci-topology/v1.00.26-w1/dag-checkpoint.json: before anchors the measured W0 baseline run (head_sha = anchor_sha = c6ee39e4…), after is the derived shape projection of the SAME head SHA under the split topology — lint loses its Racket steps and completes before test (0) starts; lint-quality runs in parallel with no downstream needs; every per-job entry carries started_at/completed_at and the record is labeled topology checkpoint — not a cohort")
                (atomicity . "the §7.1 sequence is realized inside this one PR: workflow + policy + all job-set pins changed atomically in a single commit series, so no pushed state ever had lint unrequired or lint-quality unreported; the only post-merge steps are the coordinator-owned verify-then-protect steps (lint-quality green on main BEFORE the protection requirement is added, then both required, verified via the GitHub API)")
                (rollback-rehearsal . "dry-run rollback documented in the validation record: remove the lint-quality branch-protection requirement FIRST, then restore workflow/policy, while lint stays required throughout; a half-reverted or fail-open state is a release blocker")))
(decision . ((atomic-lint-transaction . "workflow, policy, gate claims, and every job-set pin move in the same commit series — no orphaned expectations anywhere in the repo; tests first (red), then the split (green), checkpoints committed after each green step")
             (fail-closed-invariant . "lint is never removed from the required set — it keeps its name and its required status while its scope shrinks; lint-quality joins the required set only via the same atomic change, and post-merge protection lands only after lint-quality reports green on main (never-reporting window impossible by construction)")
             (timing-honesty . "the before/after DAG checkpoint is a same-SHA topology projection derived from the W0 measured baseline — explicitly labeled topology checkpoint, not a cohort; no new run was fabricated to decorate the split")
             (rollback . "revert order fixed: unrequire lint-quality first, then restore workflow/policy; lint never leaves the required set; halving the revert is a release blocker")))
(delivery . ((tdd-tests-first . #t)
             (contract-tests . "job-set pins written first and checkpoint-committed red, then the split turned them green: tests/test-milestone-gate.rkt (extended; exit 0), tests/test-w9-ci-workflow-verification.rkt (extended; 18 success(es) 0 failure(s) 0 error(s) — including the live ci-required-jobs evaluation pinning lint + lint-quality required and lint stay-required-throughout), tests/test-ci-runtime-contract.rkt (extended; 31 success(es) 0 failure(s) 0 error(s) — policy equality, per-job timing shape, same-SHA pairing)")
             (focused-suite-command . "racket tests/test-milestone-gate.rkt && racket tests/test-w9-ci-workflow-verification.rkt && racket tests/test-ci-runtime-contract.rkt && sha256sum -c artifacts/ci-topology/v1.00.26-w1/SHA256SUMS && test \"$(git branch --show-current)\" != \"main\"")
             (artifacts . ((dag-checkpoint . "artifacts/ci-topology/v1.00.26-w1/dag-checkpoint.json (same-SHA before/after topology projection; labeled checkpoint, not a cohort)")
                           (sums . "artifacts/ci-topology/v1.00.26-w1/SHA256SUMS (final; sha256sum -c clean)")
                           (pr . "campaign/v1.00.26-w1 PR — delivered through the campaign's protected-main Delivery Contract; squash-merge, post-merge main-reporting verification of lint-quality, and the protection requirement addition are owned by the runtime coordinator")))
             (honesty . ((evidence-provenance . "the SHA256SUMS manifest pins dag-checkpoint.json byte-for-byte and sha256sum -c is clean at implementation-sha efe6adb4; the non-artifact digest reproduces over the six substantive files with the recorded command")
                         (timing-honesty . "the DAG checkpoint is a derived shape projection anchored to the W0 measured baseline at the same head SHA — recorded as a topology checkpoint, explicitly not a statistical cohort")
                         (merge-honesty . "this record does not claim the squash-merge, its merge SHA, the post-merge lint-quality-on-main verification, or the branch-protection change; the coordinator owns post-verify merge binding and the §7.1 protect-then-verify API steps while the wave issue is still open")
                         (digest-provenance . "digest 3da8e5265f39df1127aa1bc17dd456b9b29d02f57fa34fc69d355aacc1a2c7e2 reproduces at implementation-sha efe6adb465563b25b635f146dfca66c9a3a83cc8; the record-only commits that add these rktd files touch no digest input")))))
(note . "W1 removes the heavyweight Racket lint from the PR critical path without ever unrequiring check-name lint: lint is now lightweight (governance + YAML validation) and lint-quality carries the full Racket lint suite and is required; the §7.1 atomic sequence plus the same-SHA DAG topology checkpoint prove there was no fail-open and no never-reporting window, and the dry-run rollback rehearsal fixes the revert order (unrequire lint-quality first, restore workflow/policy second).")
