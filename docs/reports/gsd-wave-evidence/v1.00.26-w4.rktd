(kind . "wave-evidence")
(schema-version . 2)
(campaign . "v1.00.26")
(wave . "W4")
(wave-title . "Queue scheduler for workflow shards — measured trial; decision: hold, workflow keeps the product-default batch scheduler")
(status . "ready-for-merge")
(implementation-sha . "9dc73a9d79bb47569ad1dd337e2f818f48ce01f4")
(dependency-sha . "1def3aaf6f1ac7e9b1fd34b66bbe08e8706998ee")
(branch . "campaign/v1.00.26-w4")
(dependency-state . "branched from the W3-delivered stacked state (W3 @ 1def3aaf, including the w3 repair): the shard-plan telemetry relocation, the W0–W3 dag checkpoints + SHA256SUMS, and the extended runtime-contract pins are present in the tree and green before any W4 edit landed")
(attempt-history . ((attempt-1 . "ended in a provider/network infrastructure stop (no logic failure recorded by the runtime); the wave was preserved (attempt not consumed) and resumed from the committed state on campaign/v1.00.26-w4 — the TDD-red failing pins + queue env seam (c55e18f4), the two real CI queue runs and their measurement artifact, and the README metrics sync (70bc6f9c) were kept; this attempt finished the honest measurement outcome: the CI numbers justified hold, so the workflow-level pin was flipped from 'queue env present' to the product-default scheduler contract (red→green), raco fmt applied to the touched test file, and the checkpoint landed as 9dc73a9d")))
(non-artifact-content-digest . "2a5cab88cef83b48d7e6df4b7852df59fb2c72c75e789be693b9f0be13ce5f2f")
(non-artifact-digest-inputs . ".github/workflows/ci.yml tests/test-ci-runtime-contract.rkt (paths relative to repo root; reproduce with: cd q && for f in .github/workflows/ci.yml tests/test-ci-runtime-contract.rkt; do git show 9dc73a9d79bb47569ad1dd337e2f818f48ce01f4:$f | sha256sum; done | awk '{print $1}' | sort | sha256sum; tests/test-runner-work-queue.rkt is deliberately NOT a digest input — it is byte-unchanged by this wave, per the plan's 'extended only if a workflow-level pin is missing' clause: the hold decision requires no workflow-level scheduler pin, and the scheduler-level contracts live in tests/test-runner-scheduler-characterization.rkt)")
(measurement . ((gate-text . "Roadmap v1.00.26 §7 W4: introduce queue scheduling for workflow test shards conservatively — the existing --jobs 2 behavior first, with p50 and worker-isolation measured from real CI runs before any wider change; no worker-count change in this wave. A missed or unreliable measurement records hold with observed numbers; the workflow keeps batch; targets are never revised inside the wave.")
                (gate-evaluable . #t)
                (gate-verdict . hold)
                (gate-verdict-label . "HOLD per the wave's own reliability rule: queue was trialed on the wave branch with TEST_RUNNER_SCHEDULER=queue in the ci.yml workflows job, measured against real CI runs, and the measurement was not reliable enough to justify activation — queue p50 exceeded batch p50 on both shards (+8.7% / +24.8%) from only n=2 queue samples taken inside a single ~30-minute contention-confounded window, with no reliable p95; the workflow keeps the product-default batch scheduler, the env entry was removed again, and a follow-up decision is required before any re-trial; targets were not revised")
                (batch-baseline . "5 real CI runs on main-ancestry SHAs (ba3fe3e0, 6c2480b0, 879d6321, a8424304, 11100893): shard-0 p50 637s / shard-1 p50 610s; p95 recorded as max (weak upper bound, flagged unreliable at n=5)")
                (queue-branch-cohort . "2 real CI runs on the wave branch (run-ids 34064484738 @ c55e18f4 and 34065151613 @ 70bc6f9c, both with TEST_RUNNER_SCHEDULER=queue set in the ci.yml workflows job): shard-0 p50 692.5s / shard-1 p50 761.5s; p95 recorded as max (weak upper bound, flagged unreliable at n=2)")
                (reliability-limitation . "both queue runs executed inside a single ~30-minute window on the same evening, so runner-pool contention is a confound; the batch baseline spans 5 runs over multiple days — the comparison is directionally negative but not reliable enough to activate queue, and equally not reliable enough to claim queue is slower in general")
                (same-sha-a-b . "at the same head SHA 70bc6f9c locally, runner version 1.00.25, run-tests.rkt --suite workflows --jobs 2 --timeout 90 per shard under TEST_RUNNER_SCHEDULER=batch vs =queue: shard-0 15/15 files pass in both modes, shard-1 14/14 in both; selection, order, and verdicts equal; run_summary JSON shape equal — run_summary carries no scheduler field in either mode, so scheduler choice provably does not alter the JSON shape")
                (worker-isolation-spot-check . "shard files disjoint (15 + 14 = 29, no overlap); worktree clean after both scheduler modes; zero leftover runner state outside tmp; no cross-shard state leakage observed")
                (artifact . "artifacts/ci-topology/v1.00.26-w4/shard-measurement.json (schema q.ci-topology.shard-measurement/1) binds every number above; checksummed by artifacts/ci-topology/v1.00.26-w4/SHA256SUMS")))
(decision . ((outcome . "hold")
             (workflow-keeps . "batch (the product default); TEST_RUNNER_SCHEDULER is not set anywhere in .github/workflows/ci.yml — the workflows job comment records the decision and points at the measurement artifact")
             (tdd-honesty . "the wave followed red→green→decision: the failing-first pins demanded a queue env seam (c55e18f4, red), the seam was added and the pins went green, real CI measurement then said hold, and the pin was flipped to the honest contract — 'ci.yml must not set TEST_RUNNER_SCHEDULER anywhere' — with the negative regexp tightened to env assignments (TEST_RUNNER_SCHEDULER:) so the explanatory comment survives linting; the red→green→hold sequence is recorded here rather than hidden")
             (no-target-revision . "the verdict target 'queue at or below batch p50 with reliable p95 and clean isolation' stands unmet and unrevised inside the wave; verdict-target-met stays false in the artifact")
             (no-worker-count-change . "the workflows shard matrix remains shard: [0, 1] with jobs 2 — untouched in this wave")
             (env-seam-future . "the runner-side TEST_RUNNER_SCHEDULER seam stays available for a measured re-trial; unsetting the variable restores the product default everywhere; re-activation requires a follow-up decision with reliable measurements, per the wave rule")
             (rollback . "no behavior changed on main-ancestry code paths: the delivered state is byte-identical to the pre-wave workflow scheduler behavior (batch default); the only live diffs are the decision comment, the strengthened test pin, and record-only artifacts")))
(delivery . ((tdd-tests-first . #t)
             (contract-tests . "tests/test-ci-runtime-contract.rkt (extended; 38 success(es) 0 failure(s) 0 error(s) — failing-first W4 pins then the hold contract: workflow shards must NOT set TEST_RUNNER_SCHEDULER; TEST_RUNNER_SCHEDULER=batch still forces batch everywhere; unset defaults to the product default; scheduler choice does not alter selection, verdicts, JSON shape, or result order; shard-measurement.json exists, stays schema- and checksum-bound, records n=5 batch + n=2 queue, verdict-target-met=false, and decision.outcome=hold), tests/test-runner-work-queue.rkt (unchanged — no workflow-level pin was required by the hold decision; 11 success(es) 0 failure(s) 0 error(s)), tests/test-runner-scheduler-characterization.rkt (unchanged from W2-era extension; 18 success(es) 0 failure(s) 0 error(s))")
             (focused-suite-command . "racket tests/test-ci-runtime-contract.rkt && racket tests/test-runner-work-queue.rkt && racket tests/test-runner-scheduler-characterization.rkt && sha256sum -c artifacts/ci-topology/v1.00.26-w4/SHA256SUMS && test \"$(git branch --show-current)\" != \"main\" — all green at implementation-sha")
             (artifacts . ((shard-measurement . "artifacts/ci-topology/v1.00.26-w4/shard-measurement.json (real CI cohort numbers, same-SHA A/B, isolation spot-check, hold decision)")
                           (sha256sums . "artifacts/ci-topology/v1.00.26-w4/SHA256SUMS (binds shard-measurement.json byte-for-byte; verified OK in-suite and standalone)")))
             (pr-plan . "single PR from campaign/v1.00.26-w4 to main carrying the decision comment, the strengthened contract pin, the measurement artifact pair, and this evidence trio; squash-merge and post-merge gate confirmation are coordinator-owned"))))
(record-only . "this evidence file adds no code and touches no digest input")
