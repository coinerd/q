 (deliverables
  ((file scripts/proof-bundle/consume.rkt)
   (detail "CLI adapter over the untouched W5 writer/validator: write assembles + finalizes the bundle (producer completeness gate fail-closed) and prints the content-addressed bundle_id; consume runs validate-proof-bundle-file and writes the §11.3 record; deterministic for byte-identical inputs (created_at must be supplied by the caller, never invented); deps racket/base + json/contract/date/file/string only; no network/threads/sleeps"))
