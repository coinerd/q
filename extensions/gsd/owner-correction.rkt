#lang racket/base
;; Separate owner authority, NOT an author allowance or a model tool. The CLI
;; holds the campaign lease; /go only reads existing immutable authority.
(require racket/file racket/list racket/path racket/port racket/string
         "generated-readme.rkt" "author-scope.rkt" "campaign-state.rkt"
         "campaign-repository.rkt" "delivery-journal.rkt" "delivery-receipt.rkt"
         "evidence-author-journal.rkt" "review-proof.rkt"
         (only-in "../gsd-planning/execution-policy.rkt" current-gsd-author-phase)
         (only-in "../../util/json/checksum.rkt" sha256-string)
         (only-in "../../sandbox/subprocess.rkt" run-subprocess subprocess-result-exit-code
                  subprocess-result-stdout subprocess-result-timed-out? subprocess-result-truncated?))
(provide propose-owner-correction! authorize-owner-correction! apply-owner-correction!
         validate-owner-correction! current-owner-correction-root
         current-owner-correction-cut correction-digest)
;; Trusted embedding configuration only, never a CLI/project supplied path.
(define current-owner-correction-root
  (make-parameter (build-path (find-system-path 'home-dir) ".q" "agent" "owner-corrections")))
;; Fault injection at durable transaction cuts, never supplies approval.
(define current-owner-correction-cut (make-parameter (lambda (_) (void))))
(define directive
  "Resolve that scope conflict through an authorized correction (BUG-0087) so q /go can resume.")
(define (need v msg) (unless v (error 'owner-correction "~a" msg)) v)
(define (owner!) (need (not (current-gsd-author-phase)) "unavailable in author phase"))
(define (canonical v)
  (cond [(hash? v) (for/list ([k (in-list (sort (hash-keys v) symbol<?))])
                    (list k (canonical (hash-ref v k))))]
        [(list? v) (map canonical v)] [else v]))
(define (correction-digest p) (sha256-string (format "~s" (canonical p))))
(define (abs p) (path->string (simplify-path (path->complete-path p) #f)))
(define (safe! p)
  (for/fold ([part (build-path "/")]) ([piece (in-list (cdr (explode-path (string->path (abs p)))))])
    (define next (build-path part piece))
    (need (not (link-exists? next)) "symlinked owner/source path") next))
(define (outside! store path)
  (define rel (path->string (find-relative-path (path->directory-path (safe! path)) (safe! store))))
  (need (or (absolute-path? (string->path rel)) (string-prefix? rel "../"))
        "private authority must be outside campaign and execution repository"))
(define (store! root cwd)
  (define p (safe! (current-owner-correction-root)))
  (outside! p root) (outside! p cwd)
  (unless (directory-exists? p) (make-directory* p) (file-or-directory-permissions p #o700))
  (need (zero? (bitwise-and (file-or-directory-permissions p 'bits) #o077))
        "owner authority directory is not private") p)
(define (stored-path store name) (safe! (build-path store name)))
(define (retain! store name value)
  (define dest (stored-path store name))
  (cond [(file-exists? dest) (need (equal? (load! store name) value) "immutable owner record differs")]
        [else
         (define tmp (make-temporary-file "intent-~a" #f store))
         (dynamic-wind void
           (lambda ()
             (call-with-output-file tmp (lambda (out) (write value out) (newline out)) #:exists 'truncate)
             (file-or-directory-permissions tmp #o400)
             (rename-file-or-directory tmp dest))
           (lambda () (when (file-exists? tmp) (delete-file tmp))))]) value)
(define (load! store name)
  (define path (stored-path store name))
  (need (and (file-exists? path)
             (zero? (bitwise-and (file-or-directory-permissions path 'bits) #o377)))
        "absent or non-private immutable owner authority")
  (call-with-input-file path
    (lambda (in) (parameterize ([read-accept-reader #f] [read-accept-lang #f])
                   (define v (read in)) (need (eof-object? (read in)) "trailing owner record") v))))
;; Discard inherited Git command/index/object redirection. Disable replacement
;; objects, hooks, signing and fsmonitor. No candidate executable is invoked.
(define (git cwd args #:index [index #f] #:commit? [commit? #f])
  (define env (environment-variables-copy (current-environment-variables)))
  (for ([k (in-list (environment-variables-names env))]
        #:when (regexp-match? #rx#"^GIT_" k)) (environment-variables-set! env k #f))
  (environment-variables-set! env #"GIT_GRAFT_FILE" #"/dev/null")
  (environment-variables-set! env #"GIT_NO_REPLACE_OBJECTS" #"1")
  (when index (environment-variables-set! env #"GIT_INDEX_FILE" (path->bytes index)))
  (when commit?
    (for ([k '(#"GIT_AUTHOR_NAME" #"GIT_COMMITTER_NAME")])
      (environment-variables-set! env k #"Q owner metadata correction"))
    (for ([k '(#"GIT_AUTHOR_EMAIL" #"GIT_COMMITTER_EMAIL")])
      (environment-variables-set! env k #"owner-correction@q.invalid"))
    (for ([k '(#"GIT_AUTHOR_DATE" #"GIT_COMMITTER_DATE")])
      (environment-variables-set! env k #"2000-01-01T00:00:00Z")))
  (define r
    (run-subprocess "git" #:args (append (list "--no-replace-objects" "-c" "core.hooksPath=/dev/null"
                                               "-c" "core.fsmonitor=false" "-c" "commit.gpgsign=false"
                                               "-C" (abs cwd)) args)
                    #:environment env #:directory cwd #:timeout 30 #:process-group? #t #:encoding 'utf-8/strict))
  (need (and (equal? (subprocess-result-exit-code r) 0)
             (not (subprocess-result-timed-out? r)) (not (subprocess-result-truncated? r)))
        (format "Git inspection/transaction failed: ~s" args))
  (subprocess-result-stdout r))
(define (fact cwd . args) (string-trim (git cwd args)))
(define (entries cwd head)
  (for/list ([s (in-list (string-split (git cwd (list "ls-tree" "-rz" head)) "\u0000"))])
    (define m (regexp-match #px"^([0-9]+) blob ([0-9a-f]+)\t(.*)$" s))
    (need m "non-blob/submodule or malformed tree")
    (list (list-ref m 3) (list-ref m 1) (list-ref m 2))))
(define (entry es path) (need (assoc path es) (format "missing committed input ~a" path)))
(define (blob cwd oid) (git cwd (list "cat-file" "blob" oid)))
;; The pinned metrics generator opens tracked paths, so a tracked .rkt link
;; contributes its target's lines under the LINK's name (even if counted twice).
;; Resolve only bounded, single-hop lexical links in this immutable Git tree.
;; In particular do not simplify away a linked/missing directory before checking
;; it, and never consult the execution filesystem to find a target.
(define (metrics-link-target cwd es e)
  (define text (blob cwd (caddr e)))
  (need (and (positive? (string-length text))
             (<= (bytes-length (string->bytes/utf-8 text)) 4096)
             (not (ormap (lambda (s) (string-contains? text s)) '("\\" "\r" "\n" "\u0000")))
             (not (regexp-match? #px"^(?:/|[A-Za-z]:)" text)))
        "unsafe committed metrics symlink target")
  (define parts (string-split text "/" #:trim? #f))
  (need (<= (length parts) 256) "committed metrics symlink target exceeds bound")
  (define base (drop-right (string-split (car e) "/") 1))
  (define resolved
    (for/fold ([dir base]) ([part (in-list parts)] [i (in-naturals)])
      (define last? (= i (sub1 (length parts))))
      (cond
        [(equal? part ".") dir]
        [(equal? part "..")
         (need (pair? dir) "committed metrics symlink escapes tree root")
         (drop-right dir 1)]
        [else
         (need (not (equal? part "")) "empty committed metrics symlink component")
         (define next (append dir (list part)))
         (unless last?
           (define path (string-join next "/"))
           (need (and (not (assoc path es))
                      (ormap (lambda (candidate)
                               (string-prefix? (car candidate) (string-append path "/"))) es))
                 "non-directory/linked/missing committed metrics symlink component"))
         next])))
  (define target (entry es (string-join resolved "/")))
  (need (member (cadr target) '("100644" "100755"))
        "committed metrics symlink target is not single-hop regular")
  ;; A final dot/up or slash denotes a directory, never a regular blob.
  (need (not (member (last parts) '("." ".." ""))) "nonregular committed metrics symlink target")
  target)
(define (inputs cwd es)
  (for/list ([e (in-list es)] #:when (string-suffix? (car e) ".rkt"))
    (define target
      (cond [(member (cadr e) '("100644" "100755")) e]
            [(equal? (cadr e) "120000") (metrics-link-target cwd es e)]
            [else (error 'owner-correction "non-regular metrics input")]))
    (cons (car e) (blob cwd (caddr target)))))
(define (index-visible! cwd)
  ;; A clean porcelain status must not hide candidate bytes via index flags.
  (for ([s (in-list (string-split (git cwd '("ls-files" "-v" "-z")) "\u0000"))])
    (need (string-prefix? s "H ") "hidden assume-unchanged/skip-worktree index entry")))
(define (binding! root plan wave j m session-live?)
  (owner!) (need (not (session-live?)) "author session is live")
  (need (and m (evidence-author-repair-pending? j) (equal? (hash-ref m 'state #f) "running"))
        "no running retained author")
  (define old (hash-ref m 'old-receipt))
  (need (not (member (hash-ref old 'branch) '("main" "master"))) "not a retained execution branch")
  (define proof (need (load-receipt-owned-proof old root plan wave) "old owned Verify proof is absent"))
  (define cwd (hash-ref (hash-ref m 'context) 'repo))
  (safe! cwd)
  (index-visible! cwd)
  (need (equal? (abs cwd) (abs (fact cwd "rev-parse" "--show-toplevel"))) "execution root redirected")
  (need (equal? (abs cwd) (abs (hash-ref proof 'execution-cwd))) "unauthenticated execution checkout")
  (define rec (load-campaign-record root plan))
  (define fence (hash-ref m 'successor-fence))
  (define w (and rec (current-wave-for-attempt rec wave fence (hash-ref m 'successor-attempt))))
  (define frozen (frozen-verify-binding root plan wave))
  (need (and w (equal? (campaign-plan-id rec) plan)
             (not (campaign-record-cancellation rec)) (not (campaign-record-budget-pause rec))
             (memq (campaign-wave-status w) '(done awaiting-delivery))
             (equal? (campaign-record-plan-snapshot-digest rec) (hash-ref frozen 'snapshot-sha256))
             (equal? (hash-ref (hash-ref m 'context) 'snapshot-sha256) (hash-ref frozen 'snapshot-sha256))
             (equal? (frozen-author-files root plan wave) (hash-ref m 'frozen-files))
             (member (campaign-wave-delivery-branch w) (list "" (hash-ref old 'branch)))
             (equal? (fact cwd "symbolic-ref" "--short" "HEAD") (hash-ref old 'branch))
             (equal? (fact cwd "config" "--get" "remote.origin.url") (hash-ref old 'origin))
             (equal? (abs (fact cwd "rev-parse" "--path-format=absolute" "--git-common-dir"))
                     (abs (build-path (hash-ref old 'repo) ".git"))))
        "stale campaign/fence/snapshot/repository binding")
  (values cwd (hasheq 'root (abs root) 'plan plan 'wave wave 'journal j 'frozen frozen
                      'execution-cwd (abs cwd)
                      'execution-gitdir (fact cwd "rev-parse" "--path-format=absolute" "--git-dir")
                      'execution-index (fact cwd "rev-parse" "--path-format=absolute" "--git-path" "index")
                      'old-proof proof
                      'attempt (hash-ref m 'successor-attempt) 'fence fence)))
(define (scope! cwd old parent files)
  (need (and (not (equal? (hash-ref old 'head) parent))
             (equal? (fact cwd "merge-base" (hash-ref old 'head) parent) (hash-ref old 'head)))
        "author parent is not a strict descendant")
  (define history (string-split (fact cwd "rev-list" (string-append (hash-ref old 'head) ".." parent)) "\n"))
  (need (<= (length history) 128) "author history exceeds bounded scan")
  (for* ([c (in-list history)]
         [p (in-list (string-split (git cwd (list "diff-tree" "--root" "--no-commit-id" "--name-only"
                                                 "--no-renames" "-r" "-m" "-z" c)) "\u0000"))])
    (need (member p files) (format "committed author path outside frozen FILES: ~s" p))))
(define (with-private-index store proc)
  (define dir (make-temporary-file "index-~a" 'directory store))
  (file-or-directory-permissions dir #o700)
  (dynamic-wind void (lambda () (proc (build-path dir "index") dir))
                (lambda () (delete-directory/files dir))))
(define (derive! cwd store parent)
  (define es (entries cwd parent))
  (for ([g (in-list recognized-metrics-generators)])
    (need (equal? (sha256-string (blob cwd (caddr (entry es (car g))))) (cdr g))
          "unrecognized project metrics generator"))
  (define before-entry (entry es "README.md"))
  (need (member (cadr before-entry) '("100644" "100755")) "README is not regular")
  (define before (blob cwd (caddr before-entry)))
  (define after (generated-readme-correction before (inputs cwd es)))
  (need (not (equal? before after)) "no generated correction needed")
  (with-private-index
   store
   (lambda (index dir)
     (define content (build-path dir "README"))
     (define message (build-path dir "message"))
     (display-to-file after content #:exists 'error)
     (display-to-file "BUG0087: separately authorized generated README counters\n" message #:exists 'error)
     (define after-oid (fact cwd "hash-object" "-w" "--" (path->string content)))
     (git cwd (list "read-tree" parent) #:index index)
     (git cwd (list "update-index" "--add" "--cacheinfo" (cadr before-entry) after-oid "README.md") #:index index)
     (define tree (string-trim (git cwd '("write-tree") #:index index)))
     (define commit (string-trim (git cwd (list "commit-tree" tree "-p" parent "-F" (path->string message)) #:commit? #t)))
     (hasheq 'parent parent 'parent-tree (fact cwd "rev-parse" (string-append parent "^{tree}"))
             'tree tree 'commit commit 'before-entry before-entry
             'after-entry (list "README.md" (cadr before-entry) after-oid)
             'before before 'after after 'inputs es 'generators recognized-metrics-generators))))
(define (state! cwd p #:replay? [replay? #f])
  (define delta (hash-ref p 'delta))
  (define parent (hash-ref delta 'parent))
  (define commit (hash-ref delta 'commit))
  (define head (fact cwd "rev-parse" "HEAD"))
  (need (or (equal? head parent) (and replay? (equal? head commit))) "source HEAD raced")
  ;; Every staged/unstaged/untracked path must be this one path. Its actual
  ;; bytes, mode and index blob must each be exactly before or after.
  (define status (git cwd '("status" "--porcelain=v1" "-z" "--untracked-files=all")))
  (for ([s (in-list (string-split status "\u0000"))])
    (need (and (>= (string-length s) 4) (equal? (substring s 3) "README.md")
               (not (string-prefix? s "??"))) "mixed/dirty execution checkout"))
  (define path (safe! (build-path cwd "README.md")))
  (need (and (file-exists? path)
             (member (file->string path) (list (hash-ref delta 'before) (hash-ref delta 'after)))
             (equal? (if (zero? (bitwise-and (file-or-directory-permissions path 'bits) #o100)) "100644" "100755")
                     (cadr (hash-ref delta 'before-entry)))) "README prose/bytes/mode differ")
  (define stage (git cwd '("ls-files" "--stage" "-z" "--" "README.md")))
  (define accepted
    (for/list ([e (in-list (list (hash-ref delta 'before-entry) (hash-ref delta 'after-entry)))])
      (format "~a ~a 0\tREADME.md\u0000" (cadr e) (caddr e))))
  (need (member stage (if replay? accepted (list (car accepted)))) "README index differs")
  (need (equal? (git cwd (list "diff" "--cached" "--name-only" "-z" parent "--" "." ":(exclude)README.md")) "")
        "non-README index drift")
  head)
(define (proposal-name digest) (need (regexp-match? #px"^[0-9a-f]{64}$" digest) "invalid proposal digest")
  (string-append digest ".proposal"))
(define (authority-name plan wave commit) (format "~a-W~a-~a.authority" plan wave commit))
(define (propose-owner-correction! root plan wave #:session-live? session-live?)
  (define j (load-delivery-journal root plan wave))
  (define m (journal-evidence-author-repair j))
  (define-values (cwd binding) (binding! root plan wave j m session-live?))
  (define store (store! root cwd))
  (outside! store (hash-ref (hash-ref m 'old-receipt) 'repo))
  (define parent (fact cwd "rev-parse" "HEAD"))
  (scope! cwd (hash-ref m 'old-receipt) parent (hash-ref m 'frozen-files))
  (define delta (derive! cwd store parent))
  (define p (hasheq 'kind "BUG0087-owner-correction-v1" 'binding binding 'delta delta))
  (state! cwd p)
  (define-values (_cwd now) (binding! root plan wave (load-delivery-journal root plan wave) m session-live?))
  (need (equal? now binding) "proposal source/journal raced")
  (define digest (correction-digest p))
  (retain! store (proposal-name digest) p)
  ;; The operator sees exact before/after bytes and the exact commit before
  ;; issuing --authorize DIGEST. No automatic grant, /go grant, or broker.
  (hasheq 'digest digest 'proposal p))
;; Cache only the deterministic interpretation of immutable Git object IDs.
;; Authority, campaign, checkout and exact terminal commit are NEVER cached.
;; Key includes the entire delta, not a digest provided by project state.
(define checked-deltas (make-hash))
(define (revalidate! root plan wave p j m session-live?)
  (need (equal? (hash-ref p 'kind #f) "BUG0087-owner-correction-v1") "unknown owner correction protocol")
  (define-values (cwd binding) (binding! root plan wave j m session-live?))
  (need (equal? binding (hash-ref p 'binding)) "stale owner authority binding")
  (define delta (hash-ref p 'delta))
  (define store (store! root cwd))
  (outside! store (hash-ref (hash-ref m 'old-receipt) 'repo))
  (scope! cwd (hash-ref m 'old-receipt) (hash-ref delta 'parent) (hash-ref m 'frozen-files))
  (define key (cons (abs cwd) delta))
  (unless (hash-ref checked-deltas key #f)
    (need (equal? delta (derive! cwd store (hash-ref delta 'parent))) "correction trees/blobs/commit differ")
    (when (>= (hash-count checked-deltas) 128) (hash-clear! checked-deltas))
    (hash-set! checked-deltas key #t))
  (define rec (load-campaign-record root plan))
  (define w (current-wave-for-attempt rec wave (hash-ref m 'successor-fence) (hash-ref m 'successor-attempt)))
  (need (member (campaign-wave-delivery-head-sha w)
                (list "" (hash-ref (hash-ref m 'old-receipt) 'head)
                      (hash-ref delta 'parent) (hash-ref delta 'commit))) "wave head drift")
  cwd)
(define (authorize-owner-correction! root plan wave digest #:session-live? session-live?)
  (owner!)
  (define j (load-delivery-journal root plan wave))
  (define m (journal-evidence-author-repair j))
  (define-values (cwd _) (binding! root plan wave j m session-live?))
  (define store (store! root cwd))
  (define p (load! store (proposal-name digest)))
  (need (equal? digest (correction-digest p)) "proposal digest differs")
  (revalidate! root plan wave p j m session-live?)
  (state! cwd p)
  (retain! store (authority-name plan wave (hash-ref (hash-ref p 'delta) 'commit))
           (hasheq 'proposal p 'digest digest 'directive directive))
  digest)
(define (authority! root plan wave cwd commit)
  (define store (store! root cwd))
  (define a (load! store (authority-name plan wave commit)))
  (define p (hash-ref a 'proposal))
  (need (and (equal? (hash-ref a 'directive) directive)
             (equal? (hash-ref a 'digest) (correction-digest p))
             (equal? commit (hash-ref (hash-ref p 'delta) 'commit))
             (equal? p (load! store (proposal-name (hash-ref a 'digest))))) "invalid private owner authority")
  p)
(define (apply-owner-correction! root plan wave digest #:session-live? session-live?)
  (owner!)
  (define j (load-delivery-journal root plan wave))
  (define m (journal-evidence-author-repair j))
  (define-values (cwd _) (binding! root plan wave j m session-live?))
  (define store (store! root cwd))
  (define proposed (load! store (proposal-name digest)))
  (define delta (hash-ref proposed 'delta))
  (define commit (hash-ref delta 'commit))
  (define p (authority! root plan wave cwd commit))
  (need (and (equal? p proposed) (equal? digest (correction-digest p))) "authorization digest differs")
  (define (current!)
    (need (equal? p (authority! root plan wave cwd commit)) "owner authority raced")
    (need (equal? j (load-delivery-journal root plan wave)) "journal raced")
    (revalidate! root plan wave p j m session-live?)
    (state! cwd p #:replay? #t))
  (current!)
  ;; Stage outside the worktree so every source check still sees ALL dirt.
  ;; Rename must be on the README filesystem; refuse before CAS otherwise.
  (define staging (safe! (hash-ref (hash-ref p 'binding) 'execution-gitdir)))
  (define path (safe! (build-path cwd "README.md")))
  (need (equal? (hash-ref (file-or-directory-stat staging) 'device-id)
                (hash-ref (file-or-directory-stat path) 'device-id))
        "README atomic staging is not on the same filesystem")
  ;; Authority is itself immutable durable intent. Retain the apply cut before
  ;; CAS. Replay recognizes only the exact parent or this exact commit.
  (retain! store (string-append digest ".intent") (hasheq 'digest digest 'commit commit))
  ((current-owner-correction-cut) 'intent)
  (define head (current!))
  (when (equal? head (hash-ref delta 'parent))
    (git cwd (list "update-ref" (string-append "refs/heads/" (hash-ref (hash-ref m 'old-receipt) 'branch))
                   commit head)))
  ((current-owner-correction-cut) 'cas)
  (current!)
  ;; No broad add/reset/read-tree/checkout. Only the exact README index entry
  ;; and exact generated bytes are reconciled, including a crash after CAS.
  (define e (hash-ref delta 'after-entry))
  (git cwd (list "update-index" "--cacheinfo" (cadr e) (caddr e) "README.md"))
  ((current-owner-correction-cut) 'index)
  (current!)
  (unless (equal? (file->string path) (hash-ref delta 'after))
    (define mode (file-or-directory-permissions path 'bits))
    (define tmp (make-temporary-file "owner-readme-~a" #f staging))
    (dynamic-wind void
      (lambda ()
        (define after (string->bytes/utf-8 (hash-ref delta 'after)))
        (call-with-output-file tmp
          (lambda (out)
            (define split (quotient (bytes-length after) 2))
            (write-bytes after out 0 split)
            (flush-output out)
            ((current-owner-correction-cut) 'readme-writing)
            (write-bytes after out split))
          #:exists 'truncate)
        (file-or-directory-permissions tmp mode)
        ((current-owner-correction-cut) 'readme-pre-rename)
        ;; Re-read authority AND all source guards after writing/fault cuts,
        ;; immediately before making the complete regular file visible.
        (current!)
        (need (equal? mode (file-or-directory-permissions path 'bits)) "README mode raced")
        (rename-file-or-directory tmp path #t))
      (lambda () (when (file-exists? tmp) (delete-file tmp)))))
  ((current-owner-correction-cut) 'worktree)
  (current!)
  (need (committed-delivery-snapshot cwd) "correction did not leave an exact clean checkout")
  commit)
;; Recovery calls this only for the terminal head, and still checks every
;; preceding author commit itself. Revalidation repeats at each owner boundary.
(define (validate-owner-correction! root plan wave source j m #:session-live? session-live?)
  (owner!)
  (define cwd (hash-ref (hash-ref m 'context) 'repo))
  (define commit (hash-ref source 'head))
  (define p (authority! root plan wave cwd commit))
  (revalidate! root plan wave p j m session-live?)
  (state! cwd p #:replay? #t)
  (need (equal? source (committed-delivery-snapshot cwd)) "dirty or changed correction checkout")
  (define delta (hash-ref p 'delta))
  (need (and (equal? (fact cwd "rev-list" "--parents" "-n" "1" commit)
                     (string-append commit " " (hash-ref delta 'parent)))
             (equal? (hash-ref source 'tree) (hash-ref delta 'tree))
             (equal? (entries cwd commit)
                     (sort (cons (hash-ref delta 'after-entry)
                                 (filter (lambda (e) (not (equal? (car e) "README.md"))) (hash-ref delta 'inputs)))
                           string<? #:key car)))
        "not the exact terminal single-parent correction delta")
  commit)
