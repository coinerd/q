#!/usr/bin/env racket
#lang racket
(require racket/runtime-path
         racket/port
         racket/string
         "scripts/testing/quick-audit.rkt"
         "scripts/testing/quick-runner.rkt"
         "scripts/testing/full-plan.rkt")
(define-runtime-path root ".")
(define (fail fmt . args)
  (apply eprintf (string-append "qt: " fmt "\n") args)
  (exit 1))

;; A closed stdout (`./qt full --explain | head`) is a normal consumer ending the
;; stream, not a qt failure: writing stops quietly. Only the EPIPE case is
;; swallowed; every other write error still surfaces. Verdicts are computed
;; before printing, so this can never turn a red run green.
;; One call writes exactly one line (content plus its terminating newline), so
;; the printed plan starts at the first line and every line ends in `\n` even
;; when the pipe closes mid-plan.
(define (emit-line line #:port [port (current-output-port)])
  ;; After EPIPE, redirect the port to nowhere: exit still flushes the current
  ;; output port, and a second failing flush would print a spurious error.
  ;; The writes and the explicit flush share one handler, so a half-written
  ;; line never leaks its newline into a later (broken) port.
  (with-handlers ([exn:fail:filesystem:errno?
                   (lambda (e)
                     ;; EPIPE (32) is a consumer closing the pipe; every other
                     ;; write error (ENOSPC, EIO, EBADF) is real and re-raised.
                     (define errno (exn:fail:filesystem:errno-errno e))
                     (unless (and (pair? errno) (equal? (car errno) 32))
                       (raise e))
                     (when (eq? port (current-output-port))
                       (current-output-port (open-output-nowhere))))])
    (display line port)
    (newline port)
    ;; Flush inside the handler: a closed pipe must fail HERE, not at process
    ;; exit (where the port is no longer current and the EPIPE cannot be
    ;; redirected). Small plans are otherwise buffered until exit.
    (flush-output port)))
(define args (vector->list (current-command-line-arguments)))
(define command (and (pair? args) (car args)))
(define rest-args
  (if (pair? args)
      (cdr args)
      '()))
;; Shared option grammar. Plain commands (`quick`, `default`, `release`, and a
;; bare `full`) use --explain/--jobs/--changed plus validated positional words;
;; the CI-surface flags (Phase D) are accepted by `full`, by a bare
;; `./qt --lane NAME`, and by `default --file FILE` (explicit reproduction).
;; Unsupported options fail BEFORE any selection or execution, and every CI
;; flag that cannot be honored fails closed instead of being ignored silently.
(struct cli-options
        (jobs explain?
              changed?
              audit?
              positional
              json-out
              suite
              shard-index
              shard-total
              timeout
              profile
              ledger-path
              record-gate?
              repeat
              sequential?
              mode
              shard-plan
              durations
              files
              lane
              candidate
              evidence
              ci-flags)
  #:transparent)

(define (parse-options rest)
  (define opts
    (hash-copy (hash 'jobs
                     2
                     'explain?
                     #f
                     'changed?
                     #f
                     'audit?
                     #f
                     'positional
                     '()
                     'json-out
                     #f
                     'suite
                     #f
                     'shard-index
                     0
                     'shard-total
                     1
                     'timeout
                     #f
                     'profile
                     'local
                     'ledger-path
                     #f
                     'record-gate?
                     #f
                     'repeat
                     1
                     'sequential?
                     #f
                     'mode
                     'auto
                     'shard-plan
                     #f
                     'durations
                     #f
                     'files
                     '()
                     'lane
                     #f
                     'candidate
                     #f
                     'evidence
                     #f
                     'ci-flags
                     '())))
  (define seen (make-hash))
  (define (mark! flag)
    (when (hash-ref seen flag #f)
      (fail "duplicate ~a" flag))
    (hash-set! seen flag #t))
  (define (ci! flag)
    (hash-update! opts 'ci-flags (lambda (flags) (append flags (list flag)))))
  (define (required! rest flag)
    (when (null? rest)
      (fail "~a requires a value" flag))
    (car rest))
  (define (parse-positive-int rest flag)
    (define raw (required! rest flag))
    (define n (string->number raw))
    (unless (and (exact-integer? n) (positive? n))
      (fail "~a must be a positive integer, got: ~a" flag raw))
    n)
  (define (parse-nonnegative-int rest flag)
    (define raw (required! rest flag))
    (define n (string->number raw))
    (unless (and (exact-integer? n) (>= n 0))
      (fail "~a must be a non-negative integer, got: ~a" flag raw))
    n)
  (define (parse-positive-number rest flag)
    (define raw (required! rest flag))
    (define n (string->number raw))
    (unless (and (number? n) (real? n) (positive? n))
      (fail "~a must be a positive number, got: ~a" flag raw))
    n)
  (let loop ([rest rest])
    (cond
      [(null? rest) (void)]
      [(equal? (car rest) "--explain")
       (when (hash-ref opts 'explain?)
         (fail "duplicate --explain"))
       (hash-set! opts 'explain? #t)
       (loop (cdr rest))]
      [(equal? (car rest) "--changed")
       (when (hash-ref opts 'changed?)
         (fail "duplicate --changed"))
       (hash-set! opts 'changed? #t)
       (loop (cdr rest))]
      [(equal? (car rest) "--audit")
       (when (hash-ref opts 'audit? #f)
         (fail "duplicate --audit"))
       (hash-set! opts 'audit? #t)
       (loop (cdr rest))]
      [(equal? (car rest) "--jobs")
       (hash-set! opts 'jobs (parse-positive-int (cdr rest) "--jobs"))
       (loop (cddr rest))]
      [(equal? (car rest) "--sequential")
       (mark! "--sequential")
       (ci! "--sequential")
       (hash-set! opts 'sequential? #t)
       (hash-set! opts 'jobs 1)
       (loop (cdr rest))]
      [(equal? (car rest) "--json-out")
       (mark! "--json-out")
       (ci! "--json-out")
       (hash-set! opts 'json-out (required! (cdr rest) "--json-out"))
       (loop (cddr rest))]
      [(equal? (car rest) "--suite")
       (mark! "--suite")
       (ci! "--suite")
       (hash-set! opts 'suite (string->symbol (required! (cdr rest) "--suite")))
       (loop (cddr rest))]
      [(equal? (car rest) "--shard-index")
       (mark! "--shard-index")
       (ci! "--shard-index")
       (hash-set! opts 'shard-index (parse-nonnegative-int (cdr rest) "--shard-index"))
       (loop (cddr rest))]
      [(equal? (car rest) "--shard-total")
       (mark! "--shard-total")
       (ci! "--shard-total")
       (hash-set! opts 'shard-total (parse-positive-int (cdr rest) "--shard-total"))
       (loop (cddr rest))]
      [(equal? (car rest) "--timeout")
       (mark! "--timeout")
       (ci! "--timeout")
       (hash-set! opts 'timeout (parse-positive-number (cdr rest) "--timeout"))
       (loop (cddr rest))]
      [(equal? (car rest) "--profile")
       (mark! "--profile")
       (ci! "--profile")
       (hash-set! opts 'profile (string->symbol (required! (cdr rest) "--profile")))
       (loop (cddr rest))]
      [(equal? (car rest) "--ledger")
       (mark! "--ledger")
       (ci! "--ledger")
       (hash-set! opts 'ledger-path (required! (cdr rest) "--ledger"))
       (loop (cddr rest))]
      [(equal? (car rest) "--record-gate-evidence")
       (mark! "--record-gate-evidence")
       (ci! "--record-gate-evidence")
       (hash-set! opts 'record-gate? #t)
       (loop (cdr rest))]
      [(equal? (car rest) "--repeat")
       (mark! "--repeat")
       (ci! "--repeat")
       (hash-set! opts 'repeat (parse-positive-int (cdr rest) "--repeat"))
       (loop (cddr rest))]
      [(equal? (car rest) "--mode")
       (mark! "--mode")
       (ci! "--mode")
       (hash-set! opts 'mode (string->symbol (required! (cdr rest) "--mode")))
       (loop (cddr rest))]
      [(equal? (car rest) "--shard-plan")
       (mark! "--shard-plan")
       (ci! "--shard-plan")
       (hash-set! opts 'shard-plan (required! (cdr rest) "--shard-plan"))
       (loop (cddr rest))]
      [(equal? (car rest) "--durations")
       (mark! "--durations")
       (ci! "--durations")
       (hash-set! opts 'durations (required! (cdr rest) "--durations"))
       (loop (cddr rest))]
      [(equal? (car rest) "--lane")
       (mark! "--lane")
       (ci! "--lane")
       (hash-set! opts 'lane (required! (cdr rest) "--lane"))
       (loop (cddr rest))]
      [(equal? (car rest) "--candidate")
       (mark! "--candidate")
       (hash-set! opts 'candidate (required! (cdr rest) "--candidate"))
       (loop (cddr rest))]
      [(equal? (car rest) "--evidence")
       (mark! "--evidence")
       (hash-set! opts 'evidence (required! (cdr rest) "--evidence"))
       (loop (cddr rest))]
      [(equal? (car rest) "--file")
       (ci! "--file")
       (hash-set! opts 'files (cons (required! (cdr rest) "--file") (hash-ref opts 'files)))
       (loop (cddr rest))]
      [(string-prefix? (car rest) "-") (fail "unsupported option: ~a" (car rest))]
      [else
       (hash-update! opts 'positional (lambda (words) (cons (car rest) words)))
       (loop (cdr rest))]))
  (cli-options (hash-ref opts 'jobs)
               (hash-ref opts 'explain?)
               (hash-ref opts 'changed?)
               (hash-ref opts 'audit?)
               (reverse (hash-ref opts 'positional))
               (hash-ref opts 'json-out)
               (hash-ref opts 'suite)
               (hash-ref opts 'shard-index)
               (hash-ref opts 'shard-total)
               (hash-ref opts 'timeout)
               (hash-ref opts 'profile)
               (hash-ref opts 'ledger-path)
               (hash-ref opts 'record-gate?)
               (hash-ref opts 'repeat)
               (hash-ref opts 'sequential?)
               (hash-ref opts 'mode)
               (hash-ref opts 'shard-plan)
               (hash-ref opts 'durations)
               (reverse (hash-ref opts 'files))
               (hash-ref opts 'lane)
               (hash-ref opts 'candidate)
               (hash-ref opts 'evidence)
               (hash-ref opts 'ci-flags)))

;; `BASE..HEAD` (a commit range) or a single base ref (working-tree diff).
;; Anything else is malformed and fails closed before any git call.
(define (parse-changed-range text)
  (define parts (string-split text ".."))
  (cond
    [(= (length parts) 2)
     (define base (car parts))
     (define head (cadr parts))
     (when (or (string=? base "") (string=? head ""))
       (fail "malformed --changed range: ~a (expected BASE..HEAD)" text))
     (values base head)]
    [(= (length parts) 1)
     (when (string=? text "")
       (fail "--changed requires a base ref or BASE..HEAD"))
     (values text #f)]
    [else (fail "malformed --changed range: ~a (expected BASE..HEAD)" text)]))

;; Conservative impact selection over the audited quick owners. The @covers
;; manifest and the impact graph decide which owners a change touches; an
;; unattributable owner is INCLUDED (fail open) and an escalation includes every
;; owner. This is a REPRODUCTION label, never a PR claim, and an empty selection
;; is a failure (zero files is never a pass).
(define (quick-changed-report text)
  (define-values (base head) (parse-changed-range text))
  (define owners (admitted-owners))
  (with-handlers ([exn:fail? (lambda (e) (fail "~a" (exn-message e)))])
    (define-values (changed label outside)
      (if head
          (commits-changed base head root)
          (working-tree-changed base root)))
    (when (null? changed)
      (fail "the diff against ~a is empty (zero selection is a failure, not a pass)" label))
    (quick-changed-owners root owners changed #:base label #:outside outside)))

;; The audited entries a change report selects, in the audited (stable) order.
(define (quick-changed-entries report)
  (define included (change-report-included report))
  (define entries
    (for/list ([entry (in-list (admitted-owners))]
               #:when (member entry included))
      entry))
  (when (null? entries)
    (fail (string-append
           "changed selection is empty: the diff against ~a affects none of the ~a audited quick "
           "owners (an unattributed owner would have been INCLUDED, fail open)")
          (change-report-base report)
          (length (admitted-owners))))
  entries)

;; `quick` reads only its own plain options: a CI-surface flag must never look
;; like a quick option.
(define (run-quick-command rest)
  (define opts (parse-options rest))
  (define jobs (cli-options-jobs opts))
  (define explain? (cli-options-explain? opts))
  (define changed? (cli-options-changed? opts))
  (define audit? (cli-options-audit? opts))
  (define positional (cli-options-positional opts))
  (when (pair? (cli-options-ci-flags opts))
    (fail "quick does not accept CI-surface option ~a (only ./qt full / ./qt --lane NAME do)"
          (car (cli-options-ci-flags opts))))
  (when (cli-options-evidence opts)
    (fail "quick does not accept --evidence (only ./qt release --candidate SHA --evidence PATH)"))
  (when (> (length positional) 1)
    (fail "quick accepts at most one file or one --changed BASE..HEAD"))
  (when (and changed? (not (= (length positional) 1)))
    (fail "quick --changed requires BASE..HEAD (an explicit range; nothing is selected silently)"))
  (when (and audit? (or changed? (pair? positional) explain?))
    (fail "--audit takes no other options: it prints the admission report"))
  (when audit?
    (for ([line (in-list (audit-report-lines root))])
      (emit-line line))
    (exit 0))
  (define report (and changed? (quick-changed-report (car positional))))
  (define selected
    (and (not changed?)
         (pair? positional)
         (let* ([p (simplify-path (path->complete-path (car positional) root))]
                [entry (for/first ([entry (in-list (admitted-owners))]
                                   #:when (equal? p (simplify-path (build-path root entry))))
                         entry)])
           (unless entry
             (fail "file is not admitted to quick: ~a" (car positional)))
           entry)))
  (define entries
    (cond
      [report (quick-changed-entries report)]
      [selected (list selected)]
      [else (admitted-owners)]))
  ;; Fail closed on ANY non-admitted state (stale record, structure drift,
  ;; denylist hit, unknown owner) with the reason — never a silent pass.
  (define audit-states
    (for/list ([entry (in-list entries)])
      (owner-admission-state root entry)))
  (for ([s (in-list audit-states)]
        #:unless (eq? (admission-state-status s) 'admitted))
    (fail "quick refuses ~a: ~a (~a)"
          (admission-state-owner s)
          (admission-state-status s)
          (admission-state-reason s)))
  (cond
    [explain?
     (cond
       [report
        (printf
         "quick: changed-file impact selection over the audited quick owners (reproduction only, not a PR pass)\n")
        (for ([line (in-list (change-report-lines report))])
          (printf "~a\n" line))]
       [else (printf "quick: audited selection only\n")])
     (for ([entry entries])
       (printf "  ~a\n" entry))]
    [else
     (define files
       (for/list ([entry entries])
         (path->string (simplify-path (build-path root entry)))))
     (define results
       (with-handlers ([exn:fail? (lambda (e) (fail "~a" (exn-message e)))])
         (run-quick files jobs)))
     ;; Re-check admission AFTER the run: a source change during the run must
     ;; not be silently accepted (the record is the executed identity).
     (for ([s (in-list audit-states)]
           #:unless (and (eq? (admission-state-status s) 'admitted)
                         (audit-ok? root (admission-state-owner s))))
       (fail "quick refuses ~a post-run: ~a (~a)"
             (admission-state-owner s)
             (admission-state-status s)
             (admission-state-reason s)))
     (for ([r results]
           #:unless (quick-result-valid? r))
       (eprintf "FAILED: ~a (exit ~a, ~a failures, ~a tests)\n~a\n~a\nReproduce: ./qt quick ~a\n"
                (quick-result-path r)
                (quick-result-exit r)
                (quick-result-failed r)
                (quick-result-total r)
                (quick-result-stdout r)
                (quick-result-stderr r)
                (quick-result-path r)))
     (unless (and (= (length results) (length files))
                  (equal? (sort (map quick-result-path results) string<?) (sort files string<?))
                  (andmap quick-result-valid? results))
       (fail "quick failed or produced missing/invalid results"))
     (printf "quick passed: ~a files, ~a tests (~a)\n"
             (length results)
             (apply + (map quick-result-total results))
             (if report
                 "changed-file impact reproduction only, not a PR pass"
                 "not PR/full verification"))]))

;; ============================================================
;; CI surface (`./qt full --json-out/--suite/--shard/--file/...`)
;; ============================================================
;; The spec is validated and resolved by full-plan.rkt, which lazily loads the
;; runner internals. Every flag is either forwarded to scripts/run-tests or
;; refused with a `qt: ...` message that NAMES it (never ignored silently).
;;
;; `#:lane NAME` supplies the policy metadata CI used to hard-code in YAML: the
;; lane names an existing runner suite plus its timeout/shard-plan policy (see
;; `qt-lanes` in full-plan.rkt). Explicit flags still win (a workflow matrix owns
;; the shard index/total it instantiates); `--suite`/`--file` are refused with a
;; lane because the lane already names the selection.
(define (run-ci-surface opts #:lane [lane #f] #:command [command #f])
  ;; A lane carries a SUITE SET (final plan §6 E1); every legacy lane keeps
  ;; exactly one suite. The CI surface runs one suite per job, so a multi-suite
  ;; lane (only `required-offline` today) is refused here with the command that
  ;; resolves it — never silently reduced to its first suite.
  (define lane-suites (and lane (qt-lane-suite lane)))
  (when (and lane (> (length lane-suites) 1))
    (fail
     "--lane ~a is a suite union (~a); a CI job runs one suite — resolve it with ./qt default"
     (qt-lane-name lane)
     (string-join (map symbol->string lane-suites) ", ")))
  (define lane-suite (and lane (car lane-suites)))
  (define lane-total (and lane (qt-lane-shard-total lane)))
  (define lane-shard-plan (and lane (qt-lane-shard-plan lane)))
  (define requested-total (cli-options-shard-total opts))
  (define total (if (and lane (<= requested-total 1) (> lane-total 1)) lane-total requested-total))
  (define shard-plan (or (cli-options-shard-plan opts) lane-shard-plan))
  (when (and lane (equal? shard-plan "active") (<= total 1))
    (fail
     "--lane ~a needs --shard-total > 1 (a single shard makes the duration-aware plan meaningless)"
     (qt-lane-name lane)))
  (define label (or command (if lane "./qt --lane" "./qt full")))
  ;; The pass line names the LANE command (`full`/`default`), the explain header
  ;; names the exact spelling that produced the plan.
  (define verb (if (and command (string-contains? command "default")) "default" "full"))
  (define spec
    (qt-ci-spec (or (cli-options-suite opts) lane-suite)
                (cli-options-files opts)
                (cli-options-shard-index opts)
                total
                (or (cli-options-timeout opts) (and lane (qt-lane-timeout lane)))
                (cli-options-profile opts)
                (cli-options-ledger-path opts)
                (cli-options-json-out opts)
                (cli-options-record-gate? opts)
                (cli-options-repeat opts)
                (cli-options-mode opts)
                shard-plan
                (cli-options-durations opts)
                args))
  (define plan
    (with-handlers ([exn:fail? (lambda (e) (fail "~a" (exn-message e)))])
      (resolve-qt-ci-plan #f spec)))
  (if (cli-options-explain? opts)
      ;; Plan only: nothing executed, nothing cleaned. Output-producing flags
      ;; cannot be honored here, so they fail closed instead of being ignored.
      (let ()
        (define conflicts
          (append (if (cli-options-json-out opts)
                      (list "--json-out")
                      '())
                  (if (cli-options-record-gate? opts)
                      (list "--record-gate-evidence")
                      '())
                  (if (cli-options-shard-plan opts)
                      (list "--shard-plan")
                      '())))
        (unless (null? conflicts)
          (fail (string-append "--explain cannot be combined with ~a: it executes nothing, so those "
                               "outputs would be ignored (fail closed)")
                (string-join conflicts ", ")))
        (when lane
          (emit-line
           (format "lane: ~a (suite~a ~a; timeout ~a; shard-plan ~a; ~a)"
                   (qt-lane-name lane)
                   (if (= (length lane-suites) 1) "" "s")
                   (string-join (map symbol->string lane-suites) ", ")
                   (or (cli-options-timeout opts) (qt-lane-timeout lane) "@timeout metadata")
                   shard-plan
                   (qt-lane-description lane))))
        (with-handlers ([exn:fail? (lambda (e) (fail "~a" (exn-message e)))])
          (for ([line (in-list (qt-ci-explain-lines plan #:command label))])
            (emit-line line))))
      (let ()
        (define outcome
          (with-handlers ([exn:fail? (lambda (e) (fail "~a" (exn-message e)))])
            (run-qt-ci-plan plan (cli-options-jobs opts))))
        ;; report/measure never produce a test verdict, so they print no pass
        ;; line. A real run either fails (the runner already printed the
        ;; per-file evidence) or prints the honest pass line.
        (when (qt-ci-outcome-ran? outcome)
          (unless (zero? (qt-ci-outcome-exit-code outcome))
            (fail "full failed (exit ~a; see the per-file evidence above)"
                  (qt-ci-outcome-exit-code outcome)))
          (emit-line (qt-ci-pass-line plan (qt-ci-outcome-results outcome) #:command verb))))))

;; `full`, `default` and `release` share one path: resolve the plan once, then
;; either print it (--explain: nothing executed, nothing cleaned) or execute it
;; through the same evidence rules. Only the selection and the final verdict
;; differ per lane.
(define (run-lane-command lane rest)
  (define name
    (case lane
      [(full) "full"]
      [(default) "default"]
      [(release) "release"]))
  (define opts (parse-options rest))
  (define positional (cli-options-positional opts))
  (define jobs (cli-options-jobs opts))
  (define explain? (cli-options-explain? opts))
  (define changed? (cli-options-changed? opts))
  (define ci-flags (cli-options-ci-flags opts))
  (define lane-name (cli-options-lane opts))
  (define candidate (cli-options-candidate opts))
  (define evidence (cli-options-evidence opts))
  ;; `--candidate` belongs to `release` ONLY and is verified before anything is
  ;; selected, printed or executed: a different HEAD or a dirty checkout is
  ;; refused. The release obligations stay unconditional.
  (when (and candidate (not (eq? lane 'release)))
    (fail "~a does not accept --candidate (only ./qt release --candidate SHA)" name))
  ;; `--evidence` is release-only and bound to `--candidate`: the evidence
  ;; names a local proof bundle or artifact directory whose results must
  ;; carry the exact candidate SHA. Without a candidate there is nothing to
  ;; bind to, so the flag fails closed.
  (when (and evidence (not (eq? lane 'release)))
    (fail "~a does not accept --evidence (only ./qt release --candidate SHA --evidence PATH)" name))
  (when (and evidence (not candidate))
    (fail "--evidence requires --candidate SHA (evidence is bound to the exact candidate)"))
  (when (and lane-name (not (eq? lane 'full)))
    (fail "~a does not accept --lane (use ./qt --lane NAME or ./qt full --lane NAME)" name))
  (when (and lane-name (cli-options-suite opts))
    (fail "--lane cannot be combined with --suite: the lane already names the suite selection"))
  (when (and lane-name (pair? (cli-options-files opts)))
    (fail "--lane cannot be combined with --file: the lane already names the suite selection"))
  (when (and lane-name changed?)
    (fail "--lane cannot be combined with --changed: a lane is the CI selection"))
  (when candidate
    (with-handlers ([exn:fail? (lambda (e) (fail "~a" (exn-message e)))])
      (release-candidate-check root candidate)))
  (cond
    [(pair? ci-flags)
     (cond
       ;; Explicit reproduction on the PR lane: `--file` only, same label rules
       ;; as `full --file` (never a PR pass, never sharded, no gate evidence).
       [(eq? lane 'default)
        (define others (filter-not (lambda (flag) (equal? flag "--file")) ci-flags))
        (when (pair? others)
          (fail "default does not accept CI-surface option ~a (only ./qt full / ./qt --lane NAME do)"
                (car others)))
        (when changed?
          (fail "--changed cannot be combined with --file"))
        (when (pair? positional)
          (fail "default accepts no positional arguments: ~a (use --file FILE)" (car positional)))
        (run-ci-surface opts #:command "./qt default")]
       [(not (eq? lane 'full))
        (fail "~a does not accept CI-surface option ~a (only ./qt full / ./qt --lane NAME do)"
              name
              (car ci-flags))]
       [changed?
        (fail
         "--changed cannot be combined with CI-surface options (~a); --changed is an impact selection"
         (string-join ci-flags ", "))]
       [(pair? positional)
        (fail
         "full accepts no positional arguments: ~a (use --file FILE for an explicit reproduction run)"
         (car positional))]
       [else
        (define lane-entry
          (with-handlers ([exn:fail? (lambda (e) (fail "~a" (exn-message e)))])
            (and lane-name (qt-lane-ref lane-name))))
        (run-ci-surface opts #:lane lane-entry #:command (if lane-name "./qt --lane" "./qt full"))])]
    [else (run-plain-lane-command lane name opts positional jobs explain? changed? evidence)]))

;; Plain lanes (`full` with no CI-surface flag, `default`, `release`): behaviour
;; and guarantees are unchanged.
(define (run-plain-lane-command lane name opts positional jobs explain? changed? evidence)
  (define candidate (cli-options-candidate opts))
  (when (and changed? (eq? lane 'release))
    (fail "release does not accept --changed (a release covers the complete suite)"))
  (when (and changed? (> (length positional) 1))
    (fail "~a accepts at most one --changed base" name))
  (when (and (not changed?) (pair? positional))
    (fail
     "~a accepts no positional arguments: ~a (use ./qt full --file FILE for an explicit reproduction)"
     name
     (car positional)))
  (define base (and changed? (and (pair? positional) (car positional))))
  (define plan
    (with-handlers ([exn:fail? (lambda (e) (fail "~a" (exn-message e)))])
      (resolve-lane-plan lane #f #:changed? changed? #:base base)))
  (cond
    [explain?
     ;; Plan only: nothing executed, nothing cleaned. Selection failures print
     ;; `qt: ...` and exit 1 exactly like an execution failure, and a renderer
     ;; failure is reported the same way instead of escaping as a stack trace.
     (with-handlers ([exn:fail? (lambda (e) (fail "~a" (exn-message e)))])
       (for ([line (in-list (plan-explain-lines plan))])
         (emit-line line)))]
    [else
     ;; The verdict is computed BEFORE anything is printed: a closed stdout must
     ;; never be able to skip these checks and report success. `lane-verdict` is
     ;; pure (full-plan.rkt); the message and exit code are chosen AFTER all
     ;; output has been written.
     (define run
       (with-handlers ([exn:fail? (lambda (e) (fail "~a" (exn-message e)))])
         (run-plan plan jobs)))
     (define violations (full-run-surface-violations run))
     ;; Evidence is read OFFLINE (local files only), before the obligations
     ;; are computed. Content problems never abort the command: they make the
     ;; affected obligations unavailable, exactly like missing evidence.
     (define evidence-report
       (if (and (eq? lane 'release) evidence)
           (load-release-evidence candidate evidence)
           (release-evidence 'unavailable "no --evidence input given" 0)))
     (define obligations
       (release-apply-run
        (release-obligations-with-evidence evidence-report)
        (full-run-valid? run)
        violations))
     (define blocking
       (if (eq? lane 'release)
           (release-blocking obligations)
           '()))
     (define verdict (lane-verdict lane (full-run-valid? run) violations blocking))
     (emit-line (plan-preamble plan jobs))
     ;; Per-file evidence first, then managed-surface results: the guard
     ;; reports, it never restores. Failure messages come last.
     (for ([line (in-list (full-failure-lines run))])
       (emit-line line #:port (current-error-port)))
     (for ([line (in-list (full-surface-violation-lines run))])
       (emit-line line #:port (current-error-port)))
     (when (eq? lane 'release)
       ;; The evidence verdict first, then every obligation with its state:
       ;; these lines are why a release pass line is or is not available.
       (emit-line (release-evidence-line evidence-report))
       (for ([line (in-list (release-obligation-lines obligations))])
         (emit-line line)))
     (when (and (eq? lane 'default) (pair? (lane-plan-unavailable plan)))
       ;; The unavailable-here members ran nowhere: their count is also on the
       ;; pass line, but the list itself belongs to the run output (CI stays
       ;; authoritative for exactly these).
       (for ([u (in-list (lane-plan-unavailable plan))])
         (emit-line (format "unavailable-here: ~a (@requires ~a; verified by CI, never by this command)"
                            (unavailable-here-file u)
                            (string-join (unavailable-here-requirements u) ", ")))))
     (case verdict
       [(invalid) (fail "~a failed or produced missing/invalid results" name)]
       [(surface)
        (fail "~a modified managed repository surface(s): ~a (detected, not restored)"
              name
              (string-join violations ", "))]
       [(unverified) (fail "~a" (release-unverified-message blocking))]
       [(ok)
        (case lane
          [(release) (emit-line (release-pass-line run))]
          [(full) (emit-line (full-pass-line run))]
          [else (emit-line (default-pass-line run (length (lane-plan-unavailable plan))))])])]))

;; One usage table for the interface: every implemented command and option.
;; `./qt --help` (and `./qt help`) print it and exit 0; the error text names
;; exactly these commands, so help can never advertise a spelling that fails
;; closed.
(define (show-usage)
  (displayln "Usage: ./qt [COMMAND] [OPTIONS]")
  (newline)
  (displayln "Commands:")
  (displayln "  (none)                          Same as `default`: all mandatory PR checks")
  (displayln "  quick [FILE]                    Audited pure unit suite (one admitted file)")
  (displayln
   "  quick --changed BASE..HEAD      Changed-code impact reproduction over the audited owners")
  (displayln "  quick --audit                   Print the admission audit (admitted/review-required/rejected)")
  (displayln "  default                         Complete offline PR verification (required-offline lane)")
  (displayln "  default --file FILE             Explicit reproduction, not a complete PR pass")
  (displayln "  full                            Complete available regression suite")
  (displayln "  full --file FILE                Explicit reproduction, not a full/PR pass")
  (displayln "  release --candidate SHA         Release verification of the exact candidate")
  (displayln "  help                            This message (also --help)")
  (newline)
  (displayln "Options:")
  (displayln "  --jobs N                        Bounded parallel workers (default 2)")
  (displayln "  --explain                       Print the selection only; execute nothing")
  (displayln "  --lane NAME                     CI lane over an existing suite/shard spec")
  (displayln
   "                                  (valid: fast, fast-shard, platform, security, workflows,")
  (displayln
   "                                   arch, tui, smoke, release-smoke, unit-fast, slow, all,")
  (displayln
   "                                   required-offline — the suite union ./qt default resolves)")
  (displayln "  --changed [BASE|BASE..HEAD]     Impact selection (reproduction; never a PR claim)")
  (displayln "  --file FILE                     Explicit reproduction file (full/default only)")
  (displayln "  --candidate SHA                 Exact release candidate (release only)")
  (displayln "  --evidence PATH                 Offline CI evidence bound to the candidate (release only)")
  (newline)
  (displayln "Reproduce one test: ./qt full --file tests/test-foo.rkt")
  (displayln "Run a CI lane:      ./qt --lane fast --json-out results.json")
  (exit 0))

(cond
  [(and command (or (equal? command "--help") (equal? command "-h") (equal? command "help")))
   (show-usage)]
  ;; A bare `./qt` plus flags is the lane surface: `./qt --lane fast ...` selects
  ;; the CI lane, any other plain option belongs to the default PR lane. With NO
  ;; arguments at all the §3 interface table is explicit: `./qt` runs the
  ;; mandatory PR selection (`default`), exactly like `./qt default`. It is still
  ;; a deliberate command — the plan is resolvable and stamped with the default
  ;; lane label, and an unsupported option still fails before any selection.
  [(null? args) (run-lane-command 'default '())]
  [(or (not command) (string-prefix? command "-"))
   (if (member "--lane" args)
       (run-lane-command 'full args)
       (run-lane-command 'default args))]
  [(equal? command "quick") (run-quick-command rest-args)]
  [(equal? command "full") (run-lane-command 'full rest-args)]
  [(equal? command "default") (run-lane-command 'default rest-args)]
  [(equal? command "release") (run-lane-command 'release rest-args)]
  [else
   (fail
    (string-append "unsupported command: ~a; only quick, full, default and release are available "
                   "(reproduce a single test with ./qt full --file FILE; run a CI lane with "
                   "./qt --lane NAME)")
    command)])
