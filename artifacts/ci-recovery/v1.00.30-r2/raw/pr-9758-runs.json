d/repos","events_url":"https://api.github.com/users/coinerd/events{/privacy}","received_events_url":"https://api.github.com/users/coinerd/received_events","type":"User","user_view_type":"public","site_admin":false},"run_attempt":1,"referenced_workflows":[],"run_started_at":"2026-09-27T21:56:40Z","triggering_actor":{"login":"coinerd","id":10107520,"node_id":"MDQ6VXNlcjEwMTA3NTIw","avatar_url":"https://avatars.githubusercontent.com/u/10107520?v=4","gravatar_id":"","url":"https://api.github.com/users/coinerd","html_url":"https://github.com/coinerd","followers_url":"https://api.github.com/users/coinerd/followers","following_url":"https://api.github.com/users/coinerd/following{/other_user}","gists_url":"https://api.github.com/users/coinerd/gists{/gist_id}","starred_url":"https://api.github.com/users/coinerd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coinerd/subscriptions","organizations_url":"https://api.github.com/users/coinerd/orgs","repos_url":"https://api.github.com/users/coinerd/repos","events_url":"https://api.github.com/users/coinerd/events{/privacy}","received_events_url":"https://api.github.com/users/coinerd/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/coinerd/q/actions/runs/36353531203/jobs","logs_url":"https://api.github.com/repos/coinerd/q/actions/runs/36353531203/logs","check_suite_url":"https://api.github.com/repos/coinerd/q/check-suites/98434462850","artifacts_url":"https://api.github.com/repos/coinerd/q/actions/runs/36353531203/artifacts","cancel_url":"https://api.github.com/repos/coinerd/q/actions/runs/36353531203/cancel","rerun_url":"https://api.github.com/repos/coinerd/q/actions/runs/36353531203/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/coinerd/q/actions/workflows/258814980","head_commit":{"id":"5dfd3434430ebbc321eba3144e34adf2e2511f26","tree_id":"803797f335d12422b5abc065312e98524f8e07f7","message":"fix(gsd): scope slug-consistency warnings to rows whose arrow target is absent\n\nThe v1.00.30 W0 /go run emitted a false advisory:\n\n  WARNING (slug mismatch, BUG-0041): W0 — PLAN.md targets\n  waves/W0-ci-exit-truth-and-recovery-contract.md but a wave doc exists on\n  disk as .planning/waves/W0-delivery-integrity-failure-freeze.md. Align the\n  arrow target with the doc filename.\n\nThat remedy is wrong here and would have caused real damage.\n\ncheck-slug-consistency scanned every file in .planning/waves/ matching\n`^W<idx>-` and flagged any whose slug differed from the PLAN.md row. But\n.planning/waves/ is shared by every campaign, and v1.00.30 and v1.00.31 both\nship W0, W1, W2, W5, W6 and W7. The second file is v1.00.31's W0, belonging to\na campaign that is complete and closed. The check has no campaign scoping, so\nit reported another campaign's document as drift in the v1.00.30 plan.\n\nFollowing its instruction would have re-pointed a correct arrow at a foreign\ndocument, after which load-plan-from-index loads the WRONG content for that\nwave — silently substituting one wave's doc for another's.\n\nThe fix is a one-condition scope: report a mismatch only when the row's arrow\ntarget does NOT exist. That is the only case where there is genuinely nothing\nto align but a differently-named candidate, and it is exactly the case the\npre-existing test pins. When the arrow target exists the plan already resolves\nthat wave unambiguously, so a co-located document from another campaign is not\ndrift. A missing arrow target is unaffected — it remains BUG-0023\nstrict-validation territory, which raises rather than warns.\n\nRed first. New test `a co-located doc from ANOTHER campaign is not a slug\nmismatch` in tests/test-wave-doc-lint.rkt fails on the unfixed code with 2\nspurious mismatches, and passes after. The pre-existing `slug mismatch is\nreported through the consistency surface` still passes, so the real case is\nnot weakened; a separate negative control confirms a genuine misnaming (arrow\ntarget absent, only a differently-named doc present) is still reported.\n\nVerified on the real tree: the amended v1.00.30 plan now yields 0 mismatches\nand 0 warning lines, down from 1 false positive. Against the live\n.planning/waves/ this also silences the equivalent W1/W2/W5/W6/W7 advisories\nthat share the same cause.\n\nTwo lint failures surfaced during the change and were fixed at source rather\nthan waived: the new test's comment contained a hard-coded version literal,\nwhich the BUG-0009 version-expectation lint rejects in tests/ (reworded), and\nmetrics drifted by the lines added (regenerated canonically with\n`racket scripts/metrics.rkt --tests --sync-all`; README moves only by this\nchange's own counts). lint-all is back to 23 passed, 2 warnings.\n\nVerification: wave-doc lint 10/10; gsd campaign-repository 34/34; gsd\ncampaign-state 29/29; gsd plan-snapshot 17/17; gsd delivery-coordinator 20/20;\nworkflows suite 33 files / 316 tests; fast suite 1209 files / 17997 tests, 0\nfailed; check-deps clean; raco fmt canonical and raco make clean on both\nchanged files.","timestamp":"2026-09-27T21:56:26Z","author":{"name":"CI Fixture","email":"ci@example.invalid"},"committer":{"name":"CI Fixture","email":"ci@example.invalid"}},"repository":{"id":1204314088,"node_id":"R_kgDOR8hf6A","name":"q","full_name":"coinerd/q","private":false,"owner":{"login":"coinerd","id":10107520,"node_id":"MDQ6VXNlcjEwMTA3NTIw","avatar_url":"https://avatars.githubusercontent.com/u/10107520?v=4","gravatar_id":"","url":"https://api.github.com/users/coinerd","html_url":"https://github.com/coinerd","followers_url":"https://api.github.com/users/coinerd/followers","following_url":"https://api.github.com/users/coinerd/following{/other_user}","gists_url":"https://api.github.com/users/coinerd/gists{/gist_id}","starred_url":"https://api.github.com/users/coinerd/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/coinerd/subscriptions","organizations_url":